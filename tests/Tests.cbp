					<Add library="user32" />
					<Add library="uuid" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++17" />
			<Add directory="." />
			<Add directory="../include" />
			<Add directory="../third_party/cjson" />
		</Compiler>
		<Unit filename="test_vics_json.cpp" />
