<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="X-Ways C4All Tests" />
		<Option compiler="gcc-mingw32" />
		<Build>
			<Target title="Tests">
				<Option output="../bin/Tests/C4All_Tests" prefix_auto="0" extension_auto="1" />
